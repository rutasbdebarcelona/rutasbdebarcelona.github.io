---
import BaseLayout from '../layouts/BaseLayout.astro';import { getPublicSiteDesign } from '../lib/site-settings';const design=await getPublicSiteDesign(),c=design.editorial.es;
---
<BaseLayout title={c.termsTitle} noindex><article class="legal section"><p class="kicker dark">{c.termsKicker}</p><h1>{c.termsTitle}</h1><p class="legal-warning">{c.termsWarning}</p>{[1,2,3,4].map(i=><><h2>{c[`terms${i}Title`]}</h2><p>{c[`terms${i}Body`]}</p></>)}</article></BaseLayout>