---
import BaseLayout from '../layouts/BaseLayout.astro';import PageVisualHero from '../components/PageVisualHero.astro';
import PageVisualSection from '../components/PageVisualSection.astro';import { getPublicSiteDesign } from '../lib/site-settings';const design=await getPublicSiteDesign(),c=design.editorial.es;
---
<BaseLayout title={c.termsTitle} noindex><PageVisualHero kicker={c.termsKicker} title={c.termsTitle} intro={c.termsWarning} visual={design.pageVisuals.terms} locale="es" compact /><PageVisualSection visual={design.pageVisuals.termsContent} class="legal" locale="es"><article>{[1,2,3,4].map(i=><><h2>{c[`terms${i}Title`]}</h2><p>{c[`terms${i}Body`]}</p></>)}</article></PageVisualSection></BaseLayout>
