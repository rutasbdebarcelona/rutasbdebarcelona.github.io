---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageVisualHero from '../../components/PageVisualHero.astro';
import PageVisualSection from '../../components/PageVisualSection.astro';
import { getPublicSiteDesign } from '../../lib/site-settings';
import { getPublicPosts } from '../../lib/publications';
const base=import.meta.env.BASE_URL;
const design=await getPublicSiteDesign();
const copy=design.editorial.es;
const posts=await getPublicPosts();
---
<BaseLayout locale="es" title={copy.publicationsTitle} description={copy.publicationsIntro}>
  <PageVisualHero kicker={copy.publicationsKicker} title={copy.publicationsTitle} intro={copy.publicationsIntro} visual={design.pageVisuals.publications} locale="es" compact />
  <PageVisualSection visual={design.pageVisuals.publicationsContent} class="editorial-listing" locale="es">
    {posts.length===0?<p class="editorial-empty">{copy.publicationsEmpty}</p>:<div class="editorial-post-grid">{posts.map(post=><article class="editorial-post-card">{post.cover_url&&<img src={post.cover_url} alt={post.cover_alt_es||post.title_es} loading="lazy" />}<div><p class="kicker dark">{post.tags?.join(' · ')}</p><h2><a href={`${base}publicaciones/${post.slug}/`}>{post.title_es}</a></h2><p>{post.excerpt_es}</p><a class="text-link" href={`${base}publicaciones/${post.slug}/`}>{copy.publicationsReadMore}</a></div></article>)}</div>}
  </section>
</BaseLayout>
<style>.editorial-listing{display:grid;gap:36px}.editorial-listing-head{max-width:780px}.editorial-listing-head h1{font-size:clamp(3rem,8vw,6.5rem);margin:.12em 0}.editorial-post-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.editorial-post-card{background:#fff;border:1px solid #d8d4cb}.editorial-post-card img{width:100%;aspect-ratio:16/9;object-fit:cover}.editorial-post-card>div{padding:24px}.editorial-post-card h2{font-size:clamp(1.6rem,3vw,2.35rem);margin:.25em 0}.editorial-post-card h2 a{color:inherit;text-decoration:none}.editorial-empty{padding:28px;background:#fff;border:1px solid #d8d4cb}@media(max-width:720px){.editorial-post-grid{grid-template-columns:1fr}}</style>
