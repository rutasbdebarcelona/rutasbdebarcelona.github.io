---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getPublicRoutes } from '../../lib/public-routes'; import { toEnglishRoutes } from '../../i18n/routes.en'; const bookableRoutes=toEnglishRoutes(await getPublicRoutes()).filter((route)=>route.status==='available'); const base=import.meta.env.BASE_URL; const root=base+'en/';
---
<BaseLayout locale="en" title="Book a tour" description="Book a Rutas B tour by choosing a date and one of the available time slots."><header class="page-hero compact"><div><p class="kicker">No payment at this stage</p><h1>Book your tour</h1><p>Choose a date and time. Available time slots change automatically according to the selected day.</p></div></header><section class="section form-section"><form class="booking-form" data-booking-form data-base={base} data-locale="en" novalidate><div class="form-progress" aria-label="Progress"><span class="active">1. Tour</span><span>2. Contact</span><span>3. Booking</span></div><div class="form-message" data-form-message role="alert" hidden></div><fieldset><legend>Choose the experience</legend><div class="form-grid"><label class="field full"><span>Tour</span><select name="route" required><option value="">Select a tour</option>{bookableRoutes.map((r)=><option value={r.slug}>{r.title}</option>)}</select><small data-error-for="route"></small></label><label class="field full"><span>Date</span><input name="date" type="date" required /><small data-error-for="date"></small></label><label class="field"><span>Time</span><select name="time" required disabled><option value="">Select a date first</option></select><small data-time-help>Only currently available times are shown.</small><small data-error-for="time"></small></label><label class="field"><span>Tour language</span><select name="language" required><option value="en" selected>English</option><option value="es">Spanish</option></select><small data-error-for="language"></small></label><label class="field"><span>Number of people</span><input name="people" type="number" min="1" max="15" inputmode="numeric" required /><small data-error-for="people"></small></label><label class="consent partner-check full"><input name="partnerBooking" type="checkbox" /><span>This booking is also being made on behalf of a hotel, agency or partner.</span></label></div></fieldset><fieldset><legend>Contact details</legend><div class="form-grid"><label class="field"><span>Full name</span><input name="name" autocomplete="name" required /><small data-error-for="name"></small></label><label class="field"><span>Email</span><input name="email" type="email" autocomplete="email" required /><small data-error-for="email"></small></label><label class="field full"><span>Phone <em>optional</em></span><input name="phone" type="tel" autocomplete="tel" /></label><label class="field full"><span>Special request <em>optional</em></span><textarea name="notes" rows="4" maxlength="1000" placeholder="Tell us about mobility needs, the ages in your group or any relevant context."></textarea><small class="character-count">Maximum 1,000 characters</small></label></div></fieldset><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><label class="consent"><input name="privacy" type="checkbox" required /><span>I have read the <a href={root+'privacidad/'} target="_blank">privacy policy</a> and authorise the use of these details to manage my booking.</span></label><small data-error-for="privacy"></small><div class="form-summary"><strong>Your booking</strong><p>When you submit this form, your booking will be registered. You will receive the reference, selected time and meeting point by email.</p></div><button class="button primary submit-button" type="submit">Book tour</button></form></section><script src="../../scripts/booking-form.ts"></script><style is:global>.partner-check{grid-column:1/-1}</style></BaseLayout>
