---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageVisualHero from '../../components/PageVisualHero.astro';
import PageVisualSection from '../../components/PageVisualSection.astro';import { getPublicRoutes } from '../../lib/public-routes';import { toEnglishRoutes } from '../../i18n/routes.en';import { getPublicSiteDesign } from '../../lib/site-settings';const routes=toEnglishRoutes(await getPublicRoutes()).filter(r=>r.status==='available'),base=import.meta.env.BASE_URL,root=base+'en/',design=await getPublicSiteDesign(),c=design.editorial.en;
---
<BaseLayout locale="en" title={c.bookingTitle} description={c.bookingIntro}><PageVisualHero kicker={c.bookingKicker} title={c.bookingTitle} intro={c.bookingIntro} visual={design.pageVisuals.booking} locale="en" compact /><PageVisualSection visual={design.pageVisuals.bookingContent} class="form-section" locale="en"><form class="booking-form" data-booking-form data-base={base} data-locale="en" novalidate><div class="form-progress" aria-label="Progress"><span class="active">{c.bookingStep1}</span><span>{c.bookingStep2}</span><span>{c.bookingStep3}</span></div><div class="form-message" data-form-message role="alert" hidden></div><fieldset><legend>{c.bookingExperienceLegend}</legend><div class="form-grid"><label class="field full"><span>{c.bookingRouteLabel}</span><select name="route" required><option value="">{c.bookingRoutePlaceholder}</option>{routes.map(r=><option value={r.slug} selected={r.slug==='sagrada-familia'}>{r.title}</option>)}</select><small data-error-for="route"></small></label><label class="field full"><span>{c.bookingDateLabel}</span><input name="date" type="date" required/><small data-error-for="date"></small></label><label class="field"><span>{c.bookingTimeLabel}</span><select name="time" required disabled><option value="">{c.bookingTimePlaceholder}</option></select><small data-time-help>{c.bookingTimeHelp}</small><small data-error-for="time"></small></label><label class="field"><span>{c.bookingLanguageLabel}</span><select name="language" required><option value="en" selected>English</option><option value="es">Spanish</option></select><small data-error-for="language"></small></label><label class="field"><span>{c.bookingPeopleLabel}</span><input name="people" type="number" min="1" max="15" inputmode="numeric" required/><small data-error-for="people"></small></label><label class="consent partner-check full"><input name="partnerBooking" type="checkbox"/><span>{c.bookingPartnerLabel}</span></label></div></fieldset><fieldset><legend>{c.bookingContactLegend}</legend><div class="form-grid"><label class="field"><span>{c.bookingNameLabel}</span><input name="name" autocomplete="name" required/><small data-error-for="name"></small></label><label class="field"><span>{c.bookingEmailLabel}</span><input name="email" type="email" autocomplete="email" required/><small data-error-for="email"></small></label><label class="field full"><span>{c.bookingPhoneLabel} <em>{c.bookingOptional}</em></span><input name="phone" type="tel" autocomplete="tel"/></label><label class="field full"><span>{c.bookingNotesLabel} <em>{c.bookingOptional}</em></span><textarea name="notes" rows="4" maxlength="1000" placeholder={c.bookingNotesPlaceholder}></textarea><small class="character-count">{c.bookingNotesLimit}</small></label></div></fieldset><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"/></label><label class="consent"><input name="privacy" type="checkbox" required/><span>{c.bookingPrivacyLead} <a href={root+'privacidad/'} target="_blank">{c.bookingPrivacyLink}</a> {c.bookingPrivacyTail}</span></label><small data-error-for="privacy"></small><div class="form-summary"><strong>{c.bookingSummaryTitle}</strong><p>{c.bookingSummaryCopy}</p></div><button class="button primary submit-button" type="submit">{c.bookingSubmit}</button></form></PageVisualSection><script src="../../scripts/booking-form.ts"></script><style is:global>.partner-check{grid-column:1/-1}</style></BaseLayout>
