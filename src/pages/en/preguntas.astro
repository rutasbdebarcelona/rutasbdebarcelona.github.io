---
import BaseLayout from '../../layouts/BaseLayout.astro';import { getPublicSiteDesign } from '../../lib/site-settings';const design=await getPublicSiteDesign(),c=design.editorial.en;
---
<BaseLayout locale="en" title={c.faqTitle} description={c.faqIntro}><header class="page-hero compact"><div><p class="kicker">{c.faqKicker}</p><h1>{c.faqTitle}</h1><p>{c.faqIntro}</p></div></header><section class="section faq-list">{c.faqs.map(item=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</section></BaseLayout>