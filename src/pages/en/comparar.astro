---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageVisualHero from '../../components/PageVisualHero.astro';import { getPublicRoutes } from '../../lib/public-routes';import { toEnglishRoutes } from '../../i18n/routes.en';import { getPublicSiteDesign } from '../../lib/site-settings';
const routes=toEnglishRoutes(await getPublicRoutes()),base=import.meta.env.BASE_URL,root=base+'en/',design=await getPublicSiteDesign(),c=design.editorial.en;
---
<BaseLayout locale="en" title={c.compareTitle} description={c.compareIntro}><PageVisualHero kicker={c.compareKicker} title={c.compareTitle} intro={c.compareIntro} visual={design.pageVisuals.compare} locale="en" compact /><section class="section compare-section"><div class="compare-scroll"><table class="compare-table"><thead><tr><th>{c.compareFeature}</th>{routes.map(r=><th>{r.title}<small>{r.statusLabel}</small></th>)}</tr></thead><tbody>{[[c.compareArea,'area'],[c.compareDuration,'duration'],[c.compareFormat,'format'],[c.compareLanguages,'languages'],[c.compareIndividual,'priceIndividual'],[c.compareGroup,'priceGroup']].map(([label,key])=><tr><th>{label}</th>{routes.map(r=><td>{Array.isArray((r as any)[key])?(r as any)[key].join(' · '):(r as any)[key]}</td>)}</tr>)}<tr><th>{c.compareAction}</th>{routes.map(r=><td><a class="text-link" href={`${root}rutas/${r.slug}/`}>{c.compareView}</a></td>)}</tr></tbody></table></div></section></BaseLayout>
