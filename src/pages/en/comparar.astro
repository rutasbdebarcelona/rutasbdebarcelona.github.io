---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getPublicRoutes } from '../../lib/public-routes'; import { toEnglishRoutes } from '../../i18n/routes.en'; const routes=toEnglishRoutes(await getPublicRoutes()); const root=import.meta.env.BASE_URL+'en/';
---
<BaseLayout locale="en" title="Compare tours" description="Compare the duration, area, format and languages of Rutas B tours."><header class="page-hero compact"><div><p class="kicker">Choose with clarity</p><h1>Compare the tours</h1><p>The comparison shows confirmed information. Details that remain open are marked as pending.</p></div></header><section class="section compare-section"><div class="compare-scroll"><table class="compare-table"><thead><tr><th scope="col">Feature</th>{routes.map((r)=><th scope="col">{r.title}<small>{r.statusLabel}</small></th>)}</tr></thead><tbody><tr><th scope="row">Area</th>{routes.map((r)=><td>{r.area}</td>)}</tr><tr><th scope="row">Duration</th>{routes.map((r)=><td>{r.duration}</td>)}</tr><tr><th scope="row">Format</th>{routes.map((r)=><td>{r.format}</td>)}</tr><tr><th scope="row">Languages</th>{routes.map((r)=><td>{r.languages.join(' ? ')}</td>)}</tr><tr><th scope="row">Individual price</th>{routes.map((r)=><td>{r.priceIndividual}</td>)}</tr><tr><th scope="row">Private group</th>{routes.map((r)=><td>{r.priceGroup}</td>)}</tr><tr><th scope="row">Action</th>{routes.map((r)=><td><a class="text-link" href={root+'rutas/'+r.slug+'/'}>View details &rarr;</a></td>)}</tr></tbody></table></div></section></BaseLayout>
