---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageVisualHero from '../../components/PageVisualHero.astro';import PageVisualSection from '../../components/PageVisualSection.astro';import RouteComparison from '../../components/RouteComparison.astro';import { getPublicRoutes } from '../../lib/public-routes';import { toEnglishRoutes } from '../../i18n/routes.en';import { getPublicSiteDesign } from '../../lib/site-settings';
const routes=toEnglishRoutes(await getPublicRoutes()),base=import.meta.env.BASE_URL,root=base+'en/',design=await getPublicSiteDesign(),c=design.editorial.en;
---
<BaseLayout locale="en" title={c.compareTitle} description={c.compareIntro}><PageVisualHero kicker={c.compareKicker} title={c.compareTitle} intro={c.compareIntro} visual={design.pageVisuals.compare} locale="en" compact /><PageVisualSection visual={design.pageVisuals.compareContent} class="compare-section"><RouteComparison routes={routes} copy={c} root={root} /></PageVisualSection></BaseLayout>
