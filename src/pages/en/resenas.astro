---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout locale="en" title="Reviews"><header class="page-hero compact"><div><p class="kicker">Real experiences</p><h1>Reviews</h1><p>Feedback from people who booked a tour with Rutas B de Barcelona.</p></div></header><section class="section" data-reviews-app data-locale="en"><div class="section-heading split-heading"><div><p class="kicker dark">What guests say</p><h2>Shared perspectives</h2></div><p>We only publish reviews linked to a verified booking and after moderation.</p></div><div class="reviews-grid" data-reviews-list></div><p class="admin-empty" data-reviews-empty>No reviews have been published yet.</p><div class="review-submit-layout"><div><p class="kicker dark">After your tour</p><h2>Share your experience</h2><p>You will need your booking reference and the same email address used for the booking. Your email will not be published.</p></div><form class="booking-form compact-form" data-review-form><div class="form-grid"><label class="field"><span>Booking reference</span><input name="reference" maxlength="12" autocomplete="off" required /></label><label class="field"><span>Booking email <em>required</em></span><input name="email" type="email" autocomplete="email" required /></label><label class="field"><span>Public display name</span><input name="displayName" maxlength="80" required /></label><label class="field"><span>Rating</span><select name="rating" required><option value="">Select</option><option value="5">5 — Excellent</option><option value="4">4 — Very good</option><option value="3">3 — Good</option><option value="2">2 — Could improve</option><option value="1">1 — Poor</option></select></label><label class="field full"><span>Review</span><textarea name="body" rows="6" minlength="10" maxlength="1500" required></textarea></label></div><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><label class="consent"><input name="privacy" type="checkbox" required /><span>I authorise publication of the display name and review text. My email and booking reference will not be published.</span></label><button class="button primary" type="submit">Submit review</button><p class="form-message" data-review-status aria-live="polite" hidden></p></form></div></section><script src="../../scripts/review-form.ts"></script></BaseLayout>
