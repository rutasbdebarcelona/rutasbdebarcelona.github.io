---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { TourRoute } from '../../../data/routes';
import { getPublicRoutes } from '../../../lib/public-routes';
import { toEnglishRoute, toEnglishRoutes } from '../../../i18n/routes.en';
export async function getStaticPaths(){const routes=toEnglishRoutes(await getPublicRoutes());return routes.map((route)=>({params:{slug:route.slug},props:{route}}));}
interface Props { route: TourRoute; }
const route=toEnglishRoute(Astro.props.route); const base=import.meta.env.BASE_URL; const root=base+'en/'; const image=/^https?:/i.test(route.image)?route.image:base+route.image.replace(/^\//,''); const pending=route.status!=='available'; const gallery=route.gallery??[]; const documents=route.documents??[]; const supabaseUrl=import.meta.env.PUBLIC_SUPABASE_URL??''; const supabaseKey=import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY??'';
---
<BaseLayout locale="en" title={route.title} description={route.promise}><article class="route-detail" data-route-live data-route-slug={route.slug} data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey}><header class="route-hero"><img src={image} alt={route.imageAlt} data-route-hero-image /><div class="route-hero-overlay"></div><div class="route-hero-copy"><p class="kicker">{route.eyebrow}</p><h1>{route.title}</h1><p>{route.promise}</p>{route.status!=='available'&&<span class:list={['status-pill',route.status]}>{route.statusLabel}</span>}</div></header><div class="route-booking-bar"><div><span>Duration</span><strong>{route.duration}</strong></div><div><span>Languages offered</span><strong>{route.languages.join(' · ')}</strong></div><div><span>Price</span><strong>{route.priceIndividual}</strong></div><a class="button primary" href={root+'reservar/?ruta='+route.slug}>{pending?'Ask about this tour':'Book this tour'}</a></div><div class="detail-layout section"><div class="detail-main"><section><p class="kicker dark">The experience</p><h2>A tour with its own guiding question</h2><p class="large-copy">{route.description}</p></section><section class="route-gallery" data-route-gallery hidden={gallery.length===0}><h2>Gallery</h2><div data-route-gallery-list>{gallery.map((item)=><figure><img src={item.url} alt={item.altText} loading="lazy" />{item.title&&<figcaption>{item.title}</figcaption>}</figure>)}</div></section><section class="route-documents" data-route-documents hidden={documents.length===0}><h2>Tour materials</h2><div data-route-document-list>{documents.map((item)=><a href={item.url} target="_blank" rel="noopener">{item.kind==='audio'?'Listen: ':'Open: '}{item.title}</a>)}</div></section><section><h2>The route</h2><ol class="stop-list">{route.stops.map((stop,index)=><li><span>{String(index+1).padStart(2,'0')}</span><strong>{stop}</strong></li>)}</ol></section><section class="two-columns"><div><h2>What is included</h2><ul class="check-list">{route.includes.map((item)=><li>{item}</li>)}</ul></div><div><h2>What is not included</h2><ul class="plain-list">{route.notIncluded.map((item)=><li>{item}</li>)}</ul></div></section><section><h2>Accessibility</h2><p>{route.accessibility}</p></section></div><aside class="detail-sidebar"><div class="info-card"><h2>Practical information</h2><dl><div><dt>Area</dt><dd>{route.area}</dd></div><div><dt>Format</dt><dd>{route.format}</dd></div><div><dt>Start</dt><dd>{route.startingPoint}</dd></div><div><dt>Finish</dt><dd>{route.endingPoint}</dd></div></dl></div><div class="info-card"><h2>Prices</h2><dl><div><dt>Individual</dt><dd>{route.priceIndividual}</dd></div><div><dt>Private group</dt><dd>{route.priceGroup}</dd></div></dl><p class="pending-note">No payment is charged when registering your booking.</p></div></aside></div></article><script>import '../../../scripts/route-live-media';</script></BaseLayout>
