---
import BaseLayout from '../../../layouts/BaseLayout.astro';import PageVisualHero from '../../../components/PageVisualHero.astro';
import PageVisualSection from '../../../components/PageVisualSection.astro';
import RouteCard from '../../../components/RouteCard.astro';
import { getPublicRoutes } from '../../../lib/public-routes';
import { toEnglishRoutes } from '../../../i18n/routes.en';
import { getPublicSiteDesign } from '../../../lib/site-settings';
const routes=toEnglishRoutes(await getPublicRoutes()),design=await getPublicSiteDesign(),copy=design.editorial.en;
---
<BaseLayout locale="en" title={copy.routesTitle} description={copy.routesIntro}><PageVisualHero kicker={copy.routesKicker} title={copy.routesTitle} intro={copy.routesIntro} visual={design.pageVisuals.routes} locale="en" compact /><PageVisualSection visual={design.pageVisuals.routesContent} locale="en"><div class="filter-bar" aria-label="Tour filters"><button class="filter active" data-filter="all">{copy.routesFilterAll}</button><button class="filter" data-filter="available">{copy.routesFilterAvailable}</button><button class="filter" data-filter="in-development">{copy.routesFilterPreparing}</button></div><div class="route-grid" data-route-grid>{routes.map(route=><div data-status={route.status}><RouteCard route={route} locale="en" /></div>)}</div></PageVisualSection><script is:inline>document.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-filter]').forEach(item=>item.classList.remove('active'));button.classList.add('active');document.querySelectorAll('[data-status]').forEach(card=>card.toggleAttribute('hidden',button.dataset.filter!=='all'&&card.dataset.status!==button.dataset.filter));}));</script></BaseLayout>
