---
import BaseLayout from '../../layouts/BaseLayout.astro'; const root=import.meta.env.BASE_URL+'en/';
---
<BaseLayout locale="en" title="Booking registered" noindex><section class="confirmation section"><div class="confirmation-card"><span class="confirmation-icon">&#10003;</span><p class="kicker dark" data-confirmation-mode>Booking completed</p><h1 data-confirmation-title>Thank you for choosing Rutas B</h1><p data-confirmation-copy>Your booking is registered. Keep these details; you will also receive them by email.</p><div class="confirmation-data" data-confirmation-data></div><a class="button primary" href={root}>Return to Rutas B</a></div></section><script is:inline>const target=document.querySelector('[data-confirmation-data]');const raw=sessionStorage.getItem('rutasb-last-request');if(target&&raw){const data=JSON.parse(raw);const firstName=String(data.name||'').trim().split(/\s+/)[0];const heading=document.querySelector('[data-confirmation-title]');if(heading&&firstName)heading.textContent='Thank you, '+firstName+'!';const titles={'sagrada-familia':'Sagrada Familia','barcino':'Barcino','cafeborn':'CafeBorn'};const routeTitle=data.routeTitle||titles[data.route]||data.route;const add=(text,className='')=>{const span=document.createElement('span');span.textContent=text;if(className)span.className=className;target.append(span)};const strong=document.createElement('strong');strong.textContent='Reference '+data.reference;target.append(strong);add('Tour: '+routeTitle);add('Date: '+data.date);add('Selected time: '+(data.timeLabel||data.time||'To be confirmed'),'confirmation-highlight');add('Meeting point: in front of KFC - Gaudi','confirmation-highlight');add('Address: Avinguda de Gaudi, 2, 08025 Barcelona');add('Public transport: Sagrada Familia metro station (L2 and L5)');if(data.emailSent===false)add('Your booking was registered, but the email could not be sent. Please contact us and include your reference.','confirmation-email-warning');if(data.mode==='demo'){document.querySelector('[data-confirmation-mode]').textContent='Demonstration mode';document.querySelector('[data-confirmation-copy]').textContent='The form works, but this booking was not submitted because Supabase is not connected.';}}</script><style is:global>.confirmation-data .confirmation-email-warning{color:#9b2c1f;font-weight:700;margin-top:1rem}.confirmation-data .confirmation-highlight{font-family:var(--serif);font-size:1.15rem;font-weight:700;color:var(--forest);margin-top:.35rem}</style></BaseLayout>
