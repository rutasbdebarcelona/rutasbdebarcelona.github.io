---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../../components/HomeHero.astro';
import HomeSections from '../../components/HomeSections.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { getPublicRoutes } from '../../lib/public-routes';
import { toEnglishRoutes } from '../../i18n/routes.en';
import { moduleEnabled } from '../../config/site';
import { getPublicSiteDesign } from '../../lib/site-settings';
const publishedRoutes=toEnglishRoutes(await getPublicRoutes()),base=import.meta.env.BASE_URL,design=await getPublicSiteDesign();
---
<BaseLayout locale="en" description="Cultural tours in Barcelona for travellers, groups and partners who want to understand the city through a distinctive point of view.">
  <HomeHero locale="en" {design} {base}/>
  <HomeSections locale="en" {design} routes={publishedRoutes} {base} routesEnabled={moduleEnabled('routes')}/>
  <WhatsAppButton locale="en" />
  <script>import '../../scripts/site-preview';</script>
</BaseLayout>
