---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RouteCard from '../../components/RouteCard.astro';
import ModuleShell from '../../components/ModuleShell.astro';
import { getPublicRoutes } from '../../lib/public-routes';
import { toEnglishRoutes } from '../../i18n/routes.en';
import { moduleEnabled } from '../../config/site';
import { getPublicSiteDesign } from '../../lib/site-settings';
const publishedRoutes = toEnglishRoutes(await getPublicRoutes());
const base = import.meta.env.BASE_URL; const root = base + 'en/'; const design=await getPublicSiteDesign(); const content=design.content.en;
---
<BaseLayout locale="en" description="Cultural tours in Barcelona for travellers, groups and partners who want to understand the city through a distinctive point of view.">
  <section class="hero"><div class="hero-backdrop"></div><div class="hero-inner"><div class="hero-copy"><p class="kicker">{content.homeKicker}</p><h1>{content.homeTitle}<br /><em>{content.homeAccent}</em></h1><p class="hero-lead">{content.homeLead}</p><div class="hero-actions"><a class="button primary" href={root + 'rutas/'}>Explore the tours</a><a class="button ghost" href={root + 'sobre/'}>Meet your guide</a></div><ul class="trust-row" aria-label="Main features"><li>Small groups</li><li>Spanish and English</li><li>Booking without payment</li></ul></div><aside class="hero-note"><p>{content.homeNote}</p></aside></div></section>
  <ModuleShell enabled={moduleEnabled('routes')}><section class="section routes-preview"><div class="section-heading split-heading"><div><p class="kicker dark">Choose your way in</p><h2>Three tours, three Barcelonas</h2></div><p>Each experience has its own pace and guiding question. Compare them and find the one that speaks to you.</p></div><div class="route-grid">{publishedRoutes.map((route) => <RouteCard route={route} locale="en" />)}</div><div class="center-action"><a class="button outline" href={root + 'comparar/'}>Compare the three tours</a></div></section></ModuleShell>
  <section class="manifesto"><div class="manifesto-inner"><p class="kicker">The Rutas B difference</p><blockquote>&ldquo;It is not about explaining everything. It is about giving you a compass so the city can begin to speak.&rdquo;</blockquote><div class="principles"><div><span>01</span><h3>Look first</h3><p>We begin with what is in front of you. History helps you see; it does not hide the place.</p></div><div><span>02</span><h3>Context without heaviness</h3><p>Clear ideas, questions and comparisons that help organise a complex city.</p></div><div><span>03</span><h3>A human experience</h3><p>An attentive pace, room for conversation and adaptation to the actual group.</p></div></div></div></section>
  <section class="section partner-section"><div class="partner-card"><div><p class="kicker dark">Hotels, agencies and groups</p><h2>A tour can also be adapted to your guests.</h2><p>We design versions according to duration, language, group profile and the context of the visit, while preserving the backbone of each experience.</p></div><a class="button primary" href={root + 'contacto/?tipo=partner'}>Discuss a collaboration</a></div></section>
</BaseLayout>
