---
import BaseLayout from '../../layouts/BaseLayout.astro';import RouteCard from '../../components/RouteCard.astro';import ModuleShell from '../../components/ModuleShell.astro';import { getPublicRoutes } from '../../lib/public-routes';import { toEnglishRoutes } from '../../i18n/routes.en';import { moduleEnabled } from '../../config/site';import { getPublicSiteDesign } from '../../lib/site-settings';
const publishedRoutes=toEnglishRoutes(await getPublicRoutes()),featured=publishedRoutes.find(r=>r.slug==='sagrada-familia')??publishedRoutes[0],base=import.meta.env.BASE_URL,root=base+'en/',design=await getPublicSiteDesign(),content=design.content.en;const heroImage=/^https?:/i.test(featured?.image||'')?featured.image:base+(featured?.image||'images/sagrada-familia.jpg').replace(/^\//,'');
---
<BaseLayout locale="en" description="Cultural tours in Barcelona for travellers, groups and partners who want to understand the city through a distinctive point of view."><section class="route-hero home-route-hero"><img src={heroImage} alt={featured?.imageAlt||'Barcelona'} /><div class="route-hero-overlay"></div><div class="route-hero-copy home-route-hero-copy"><p class="kicker">{content.homeKicker}</p><h1>{content.homeTitle}<em>{content.homeAccent}</em></h1><p>{content.homeLead}</p><div class="hero-actions"><a class="button primary" href={root+'rutas/'}>Explore the tours</a><a class="button ghost" href={root+'sobre/'}>Meet your guide</a></div><ul class="trust-row"><li>Small groups</li><li>Spanish and English</li><li>Book without payment</li></ul></div></section><ModuleShell enabled={moduleEnabled('routes')}><section class="section routes-preview"><div class="section-heading split-heading"><div><p class="kicker dark">Choose your way in</p><h2>Three tours, three Barcelonas</h2></div><p>Each experience has its own pace and guiding question. Find the one that speaks to you.</p></div><div class="route-grid">{publishedRoutes.map(route=><RouteCard route={route} locale="en" />)}</div></section></ModuleShell><section class="manifesto authored-manifesto"><div class="manifesto-inner"><p class="kicker">A method of our own</p><blockquote>The city is not a catalogue of monuments. It is a conversation between layers.</blockquote><div class="principles"><div><span>01 / OBSERVE</span><h3>What is in front of us</h3><p>Form, stone, streets and everyday uses begin the conversation.</p></div><div><span>02 / CONNECT</span><h3>The layers of place</h3><p>History and context appear when they help us understand what we see.</p></div><div><span>03 / CONVERSE</span><h3>A living tour</h3><p>Questions, an attentive pace and space to build your own point of view.</p></div></div></div></section><section class="section partner-section"><div class="partner-card"><div><p class="kicker dark">Hotels, agencies and groups</p><h2>A tour can also be adapted to your guests.</h2><p>We tailor duration, language, group profile and the context of the visit.</p></div><a class="button primary" href={root+'contacto/?tipo=partner'}>Discuss a collaboration</a></div></section></BaseLayout>