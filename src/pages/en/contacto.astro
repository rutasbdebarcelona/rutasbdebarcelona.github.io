---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { siteConfig } from '../../config/site';
---
<BaseLayout locale="en" title="Contact"><header class="page-hero compact"><div><p class="kicker">Let us talk</p><h1>Contact</h1><p>For general enquiries, groups, hotels, agencies and collaborations.</p></div></header><section class="section contact-section"><div class="contact-layout"><aside class="contact-info-card"><img src={import.meta.env.BASE_URL+'images/marca/rutas-b-logo.png'} alt={siteConfig.formalName} /><p class="kicker dark">Direct contact</p><h2>Let us talk about your visit</h2><p>For any further questions, write to our email address or contact us by phone.</p><div class="contact-detail"><span>Email</span><strong>{siteConfig.contact.email}</strong></div><div class="contact-detail"><span>Phone</span><strong>{siteConfig.contact.phoneDisplay}</strong></div><p class="contact-location">{siteConfig.contact.location}</p></aside><form class="booking-form compact-form contact-form" data-contact-form data-email={siteConfig.contact.email}><div class="form-grid"><label class="field"><span>Name</span><input name="name" autocomplete="name" required /></label><label class="field"><span>Email</span><input name="email" type="email" autocomplete="email" required /></label><label class="field full"><span>Type of enquiry</span><select name="type"><option>General enquiry</option><option>Hotel, agency or partner</option><option>Private group</option><option>Press or collaboration</option></select></label><label class="field full"><span>Message</span><textarea name="message" rows="7" required></textarea></label></div><div class="form-summary"><strong>Your enquiry</strong><p>Complete the form to organise the details. You can then copy the enquiry and send it to the email address shown, without opening any application.</p></div><button class="button primary" type="submit">Copy enquiry</button><p class="copy-status" aria-live="polite" data-contact-status></p></form></div></section><script is:inline>document.querySelector('[data-contact-form]')?.addEventListener('submit',async(event)=>{event.preventDefault();const form=event.currentTarget;const text=['Enquiry for Rutas B','', 'Name: '+form.name.value.trim(),'Email: '+form.email.value.trim(),'Type: '+form.type.value,'',form.message.value.trim()].join('\n');const status=document.querySelector('[data-contact-status]');try{await navigator.clipboard.writeText(text);if(status)status.textContent='Enquiry copied. Paste it into an email addressed to '+form.dataset.email+'.';}catch{if(status)status.textContent='The enquiry could not be copied automatically. Write to '+form.dataset.email+'.';}});</script></BaseLayout>
