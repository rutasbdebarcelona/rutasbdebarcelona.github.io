---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageVisualHero from '../../components/PageVisualHero.astro';import { siteConfig } from '../../config/site';import { getPublicSiteDesign } from '../../lib/site-settings';import { getPublicMessageTypes } from '../../lib/message-types';
const design=await getPublicSiteDesign(),home=design.content.en,c=design.editorial.en,base=import.meta.env.BASE_URL,messageTypes=await getPublicMessageTypes();const logo=/^https?:/i.test(design.branding.fullLogoUrl)?design.branding.fullLogoUrl:base+design.branding.fullLogoUrl.replace(/^\//,'');
---
<BaseLayout locale="en" title={c.contactPageTitle} description={c.contactPageIntro}><PageVisualHero kicker={c.contactKicker} title={c.contactPageTitle} intro={c.contactPageIntro} visual={design.pageVisuals.contact} locale="en" compact /><section class="section contact-section"><div class="contact-layout"><aside class="contact-info-card"><img src={logo} alt={design.branding.fullLogoAlt}/><p class="kicker dark">{c.contactDirectKicker}</p><h2>{home.contactTitle}</h2><p>{home.contactIntro}</p><div class="contact-detail"><span>{c.contactEmailLabel}</span><strong>{siteConfig.contact.email}</strong></div><div class="contact-detail"><span>{c.contactPhoneLabel}</span><strong>{siteConfig.contact.phoneDisplay}</strong></div><p class="contact-location">{siteConfig.contact.location}</p></aside><form class="booking-form compact-form contact-form" data-contact-form data-locale="en"><div class="form-grid"><label class="field"><span>{c.contactNameLabel}</span><input name="name" autocomplete="name" maxlength="120" required/></label><label class="field"><span>{c.contactEmailFieldLabel} <em>{c.contactRequired}</em></span><input name="email" type="email" autocomplete="email" maxlength="254" required/></label><label class="field full"><span>{c.contactTypeLabel}</span><select name="type">{messageTypes.map(item=><option value={item.key}>{item.label_en}</option>)}</select></label><label class="field full"><span>{c.contactMessageLabel}</span><textarea name="message" rows="7" minlength="2" maxlength="3000" required></textarea></label></div><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"/></label><label class="consent"><input name="privacy" type="checkbox" required/><span>{c.contactPrivacyLead} <a href={base+'en/privacidad/'} target="_blank">{c.contactPrivacyLink}</a> {c.contactPrivacyTail}</span></label><div class="form-summary"><strong>{c.contactSummaryTitle}</strong><p>{c.contactSummaryCopy}</p></div><button class="button primary" type="submit">{c.contactSubmit}</button><p class="form-message" aria-live="polite" data-contact-status hidden></p></form></div></section><script src="../../scripts/contact-form.ts"></script></BaseLayout>
