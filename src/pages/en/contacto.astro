---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { siteConfig } from '../../config/site'; import { getPublicSiteDesign } from '../../lib/site-settings';
const design=await getPublicSiteDesign(); const content=design.content.en; const base=import.meta.env.BASE_URL;
---
<BaseLayout locale="en" title="Contact"><header class="page-hero compact"><div><p class="kicker">Let us talk</p><h1>Contact</h1><p>For general enquiries, groups, hotels, agencies and collaborations.</p></div></header><section class="section contact-section"><div class="contact-layout"><aside class="contact-info-card"><img src={base+'images/marca/rutas-b-logo.png'} alt={siteConfig.formalName} /><p class="kicker dark">Direct contact</p><h2>{content.contactTitle}</h2><p>{content.contactIntro}</p><div class="contact-detail"><span>Email</span><strong>{siteConfig.contact.email}</strong></div><div class="contact-detail"><span>Phone</span><strong>{siteConfig.contact.phoneDisplay}</strong></div><p class="contact-location">{siteConfig.contact.location}</p></aside><form class="booking-form compact-form contact-form" data-contact-form data-locale="en"><div class="form-grid"><label class="field"><span>Name</span><input name="name" autocomplete="name" maxlength="120" required /></label><label class="field"><span>Email <em>required</em></span><input name="email" type="email" autocomplete="email" maxlength="254" aria-required="true" required /></label><label class="field full"><span>Type of enquiry</span><select name="type"><option value="general">General enquiry</option><option value="partner">Hotel, agency or partner</option><option value="private">Private group</option><option value="press">Press or collaboration</option></select></label><label class="field full"><span>Message</span><textarea name="message" rows="7" minlength="2" maxlength="3000" required></textarea></label></div><label class="honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><label class="consent"><input name="privacy" type="checkbox" required /><span>I have read the <a href={base+'en/privacidad/'} target="_blank">privacy policy</a> and authorise the use of these details to answer my enquiry.</span></label><div class="form-summary"><strong>Your enquiry</strong><p>The form sends your message directly to Rutas B. It will not open Outlook or any email application.</p></div><button class="button primary" type="submit">Send enquiry</button><p class="form-message" aria-live="polite" data-contact-status hidden></p></form></div></section><script src="../../scripts/contact-form.ts"></script></BaseLayout>