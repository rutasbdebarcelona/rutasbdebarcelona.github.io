---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageVisualHero from '../../components/PageVisualHero.astro';import { getPublicSiteDesign } from '../../lib/site-settings';const design=await getPublicSiteDesign(),c=design.editorial.en;
---
<BaseLayout locale="en" title={c.termsTitle} noindex><PageVisualHero kicker={c.termsKicker} title={c.termsTitle} intro={c.termsWarning} visual={design.pageVisuals.terms} locale="en" compact /><article class="legal section">{[1,2,3,4].map(i=><><h2>{c[`terms${i}Title`]}</h2><p>{c[`terms${i}Body`]}</p></>)}</article></BaseLayout>
