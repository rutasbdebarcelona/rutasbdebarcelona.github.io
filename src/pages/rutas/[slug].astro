---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RouteDetail from '../../components/RouteDetail.astro';
import type {TourRoute} from '../../data/routes';
import {getPublicRoutes} from '../../lib/public-routes';
export async function getStaticPaths(){const routes=await getPublicRoutes();return routes.map(route=>({params:{slug:route.slug},props:{route}}))}
interface Props{route:TourRoute}
const {route}=Astro.props;
---
<BaseLayout title={route.title} description={route.promise}><RouteDetail route={route} locale="es" /></BaseLayout>
