---
import BaseLayout from '../layouts/BaseLayout.astro';import { getPublicRoutes } from '../lib/public-routes';import { getPublicSiteDesign } from '../lib/site-settings';
const routes=await getPublicRoutes(),base=import.meta.env.BASE_URL,design=await getPublicSiteDesign(),c=design.editorial.es;
---
<BaseLayout title={c.compareTitle} description={c.compareIntro}><header class="page-hero compact"><div><p class="kicker">{c.compareKicker}</p><h1>{c.compareTitle}</h1><p>{c.compareIntro}</p></div></header><section class="section compare-section"><div class="compare-scroll"><table class="compare-table"><thead><tr><th>{c.compareFeature}</th>{routes.map(r=><th>{r.title}<small>{r.statusLabel}</small></th>)}</tr></thead><tbody>{[[c.compareArea,'area'],[c.compareDuration,'duration'],[c.compareFormat,'format'],[c.compareLanguages,'languages'],[c.compareIndividual,'priceIndividual'],[c.compareGroup,'priceGroup']].map(([label,key])=><tr><th>{label}</th>{routes.map(r=><td>{Array.isArray((r as any)[key])?(r as any)[key].join(' · '):(r as any)[key]}</td>)}</tr>)}<tr><th>{c.compareAction}</th>{routes.map(r=><td><a class="text-link" href={`${base}rutas/${r.slug}/`}>{c.compareView}</a></td>)}</tr></tbody></table></div></section></BaseLayout>