---
import BaseLayout from '../layouts/BaseLayout.astro';import PageVisualHero from '../components/PageVisualHero.astro';import PageVisualSection from '../components/PageVisualSection.astro';import RouteComparison from '../components/RouteComparison.astro';import { getPublicRoutes } from '../lib/public-routes';import { getPublicSiteDesign } from '../lib/site-settings';
const routes=await getPublicRoutes(),base=import.meta.env.BASE_URL,design=await getPublicSiteDesign(),c=design.editorial.es;
---
<BaseLayout title={c.compareTitle} description={c.compareIntro}><PageVisualHero kicker={c.compareKicker} title={c.compareTitle} intro={c.compareIntro} visual={design.pageVisuals.compare} locale="es" compact /><PageVisualSection visual={design.pageVisuals.compareContent} class="compare-section"><RouteComparison routes={routes} copy={c} root={base} /></PageVisualSection></BaseLayout>
