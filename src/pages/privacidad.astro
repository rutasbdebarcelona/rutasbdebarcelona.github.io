---
import BaseLayout from '../layouts/BaseLayout.astro';import PageVisualHero from '../components/PageVisualHero.astro';
import PageVisualSection from '../components/PageVisualSection.astro';import { getPublicSiteDesign } from '../lib/site-settings';const design=await getPublicSiteDesign(),c=design.editorial.es;
---
<BaseLayout title={c.privacyTitle} noindex><PageVisualHero kicker={c.privacyKicker} title={c.privacyTitle} intro={c.privacyWarning} visual={design.pageVisuals.privacy} locale="es" compact /><PageVisualSection visual={design.pageVisuals.privacyContent} class="legal" locale="es"><article>{[1,2,3,4].map(i=><><h2>{c[`privacy${i}Title`]}</h2><p>{c[`privacy${i}Body`]}</p></>)}</article></PageVisualSection></BaseLayout>
