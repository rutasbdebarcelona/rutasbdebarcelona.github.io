---
import BaseLayout from '../layouts/BaseLayout.astro';import PageVisualHero from '../components/PageVisualHero.astro';import { getPublicSiteDesign } from '../lib/site-settings';const design=await getPublicSiteDesign(),c=design.editorial.es;
---
<BaseLayout title={c.privacyTitle} noindex><PageVisualHero kicker={c.privacyKicker} title={c.privacyTitle} intro={c.privacyWarning} visual={design.pageVisuals.privacy} locale="es" compact /><article class="legal section">{[1,2,3,4].map(i=><><h2>{c[`privacy${i}Title`]}</h2><p>{c[`privacy${i}Body`]}</p></>)}</article></BaseLayout>
