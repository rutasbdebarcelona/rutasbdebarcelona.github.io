---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeSections from '../components/HomeSections.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getPublicRoutes } from '../lib/public-routes';
import { moduleEnabled } from '../config/site';
import { getPublicSiteDesign } from '../lib/site-settings';
const publishedRoutes=await getPublicRoutes(),base=import.meta.env.BASE_URL,design=await getPublicSiteDesign();
---
<BaseLayout description="Rutas culturales en Barcelona para viajeros, grupos y partners que buscan comprender la ciudad con una mirada propia.">
  <HomeHero locale="es" {design} {base}/>
  <HomeSections locale="es" {design} routes={publishedRoutes} {base} routesEnabled={moduleEnabled('routes')}/>
  <WhatsAppButton locale="es" />
  <script>import '../scripts/site-preview';</script>
</BaseLayout>
