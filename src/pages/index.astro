---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteCard from '../components/RouteCard.astro';
import ModuleShell from '../components/ModuleShell.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getPublicRoutes } from '../lib/public-routes';
import { moduleEnabled } from '../config/site';
import { getPublicSiteDesign } from '../lib/site-settings';
const publishedRoutes=await getPublicRoutes(),featured=publishedRoutes.find(r=>r.slug==='sagrada-familia')??publishedRoutes[0],base=import.meta.env.BASE_URL,design=await getPublicSiteDesign(),content=design.content.es;
const heroImage=/^https?:/i.test(featured?.image||'')?featured.image:base+(featured?.image||'images/sagrada-familia.jpg').replace(/^\//,'');
const methodImage=base+'images/editorial/metodo-propio-catedral-eixample.webp';
---
<BaseLayout description="Rutas culturales en Barcelona para viajeros, grupos y partners que buscan comprender la ciudad con una mirada propia.">
<section class="route-hero home-route-hero"><img src={heroImage} alt={featured?.imageAlt||'Barcelona'} /><div class="route-hero-overlay"></div><div class="route-hero-copy home-route-hero-copy"><p class="kicker">{content.homeKicker}</p><h1>{content.homeTitle}<em>{content.homeAccent}</em></h1><p>{content.homeLead}</p><div class="hero-actions"><a class="button primary" href={base+'rutas/'}>Explorar las rutas</a><a class="button ghost" href={base+'sobre/'}>Conoce al guía</a><a class="button ghost booking-hero-cta" href={base+'reservar/'}>Reservar ruta</a></div><ul class="trust-row"><li>Grupos pequeños</li><li>Español e inglés</li><li>Reserva sin pago</li></ul></div></section>
<ModuleShell enabled={moduleEnabled('routes')}><section class="section routes-preview"><div class="section-heading split-heading"><div><p class="kicker dark">Elige tu manera de entrar</p><h2>Tres rutas, tres Barcelonas</h2></div><p>Cada experiencia tiene un ritmo y una pregunta distinta. Encuentra la que conversa mejor contigo.</p></div><div class="route-grid">{publishedRoutes.map(route=><RouteCard route={route}/>)}</div></section></ModuleShell>
<section class="manifesto authored-manifesto"><div class="manifesto-inner"><div class="manifesto-feature"><div><p class="kicker">Un método propio</p><blockquote>La ciudad no es un catálogo de monumentos. Es una conversación entre capas.</blockquote></div><figure class="manifesto-collage"><img src={methodImage} alt="Collage editorial de la Catedral de Barcelona y el plano del Eixample" width="1536" height="1024" loading="lazy" /></figure></div><div class="principles"><div><span>01 / OBSERVAR</span><h3>Lo que está delante</h3><p>La forma, la piedra, la calle y sus usos abren la conversación.</p></div><div><span>02 / CONECTAR</span><h3>Las capas del lugar</h3><p>Historia y contexto aparecen cuando ayudan a entender lo visible.</p></div><div><span>03 / CONVERSAR</span><h3>Una ruta viva</h3><p>Preguntas, ritmo atento y espacio para construir una mirada propia.</p></div></div></div></section>
<section class="section partner-section"><div class="partner-card"><div><p class="kicker dark">Hoteles, agencias y grupos</p><h2>Una ruta también puede adaptarse a tu público.</h2><p>Diseñamos versiones por duración, idioma, perfil del grupo y contexto de la visita.</p></div><a class="button primary" href={`${base}contacto/?tipo=partner`}>Hablar de una colaboración</a></div></section>
<WhatsAppButton locale="es" />
</BaseLayout>