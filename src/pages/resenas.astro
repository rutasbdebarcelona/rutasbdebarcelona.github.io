---
import BaseLayout from '../layouts/BaseLayout.astro';import PageVisualHero from '../components/PageVisualHero.astro';
import PageVisualSection from '../components/PageVisualSection.astro';
import { getPublicSiteDesign } from '../lib/site-settings';
const design=await getPublicSiteDesign();
const content=design.content.es; const editorial=design.editorial.es;
---
<BaseLayout title={content.reviewsHeroTitle}><PageVisualHero kicker={content.reviewsHeroKicker} title={content.reviewsHeroTitle} intro={content.reviewsHeroIntro} visual={design.pageVisuals.reviews} locale="es" compact /><PageVisualSection visual={design.pageVisuals.reviewsContent} class="reviews-page" locale="es" data-reviews-app data-locale="es"><div class="section-heading split-heading"><div><p class="kicker dark">{content.reviewsListKicker}</p><h2>{content.reviewsListTitle}</h2></div><div class="review-trust-panel"><strong>{editorial.reviewsTrustTitle}</strong><p>{content.reviewsTrustText}</p><ul><li>{editorial.reviewsTrust1}</li><li>{editorial.reviewsTrust2}</li><li>{editorial.reviewsTrust3}</li></ul></div></div><div class="reviews-grid" data-reviews-list></div><p class="review-empty" data-reviews-empty>{content.reviewsEmpty}</p><div class="review-submit-layout"><div><p class="kicker dark">{content.reviewsFormKicker}</p><h2>{content.reviewsFormTitle}</h2><p>{content.reviewsFormIntro}</p></div><form class="booking-form compact-form" data-review-form><div class="form-grid"><label class="field"><span>{editorial.reviewsReferenceLabel}</span><input name="reference" maxlength="12" autocomplete="off" required /></label><label class="field"><span>{editorial.reviewsEmailLabel} <em>obligatorio</em></span><input name="email" type="email" autocomplete="email" required /></label><label class="field"><span>{editorial.reviewsDisplayNameLabel}</span><input name="displayName" maxlength="80" required /></label><label class="field"><span>{editorial.reviewsRatingLabel}</span><select name="rating" required><option value="">{editorial.reviewsRatingPlaceholder}</option><option value="5">5 — Excelente</option><option value="4">4 — Muy buena</option><option value="3">3 — Buena</option><option value="2">2 — Mejorable</option><option value="1">1 — Mala</option></select></label><label class="field full"><span>{editorial.reviewsBodyLabel}</span><textarea name="body" rows="6" minlength="10" maxlength="1500" required></textarea></label></div><label class="honeypot" aria-hidden="true">Sitio web<input name="website" tabindex="-1" autocomplete="off" /></label><label class="consent"><input name="privacy" type="checkbox" required /><span>{editorial.reviewsPrivacy}</span></label><button class="button primary" type="submit">{editorial.reviewsSubmit}</button><p class="form-message" data-review-status aria-live="polite" hidden></p></form></div></PageVisualSection><script src="../scripts/review-form.ts"></script></BaseLayout>
