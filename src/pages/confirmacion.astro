---
import BaseLayout from '../layouts/BaseLayout.astro';import { getPublicSiteDesign } from '../lib/site-settings';const design=await getPublicSiteDesign(),copy=design.editorial.es,base=import.meta.env.BASE_URL;
---
<BaseLayout title={copy.confirmationMode} noindex><section class="confirmation section"><div class="confirmation-card"><span class="confirmation-icon">✓</span><p class="kicker dark" data-confirmation-mode>{copy.confirmationMode}</p><h1 data-confirmation-title>{copy.confirmationTitle}</h1><p data-confirmation-copy>{copy.confirmationCopy}</p><div class="confirmation-data" data-confirmation-data></div><a class="button primary" href={base}>{copy.confirmationReturn}</a></div></section><script is:inline define:vars={{copy}}>const target=document.querySelector('[data-confirmation-data]'),raw=sessionStorage.getItem('rutasb-last-request');if(target&&raw){const data=JSON.parse(raw),first=String(data.name||'').trim().split(/\s+/)[0],heading=document.querySelector('[data-confirmation-title]');if(heading&&first)heading.textContent=first+', '+copy.confirmationTitle.toLowerCase();const titles={'sagrada-familia':'Sagrada Família','barcino':'Barcino','cafeborn':'Cafè Born'},route=data.routeTitle||titles[data.route]||data.route,add=(text,className='')=>{const span=document.createElement('span');span.textContent=text;if(className)span.className=className;target.append(span)},strong=document.createElement('strong');strong.textContent=copy.confirmationReference+' '+data.reference;target.append(strong);add(copy.confirmationRoute+': '+route);add(copy.confirmationDate+': '+data.date);add(copy.confirmationTime+': '+(data.timeLabel||data.time||'—'),'confirmation-highlight');add(copy.confirmationMeeting,'confirmation-highlight');add(copy.confirmationAddress);add(copy.confirmationTransport);if(data.emailSent===false)add(copy.confirmationEmailWarning,'confirmation-email-warning');}</script><style is:global>.confirmation-data .confirmation-email-warning{color:#9b2c1f;font-weight:700;margin-top:1rem}.confirmation-data .confirmation-highlight{font-family:var(--serif);font-size:1.15rem;font-weight:700;color:var(--forest);margin-top:.35rem}</style></BaseLayout>