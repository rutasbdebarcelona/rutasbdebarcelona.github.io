---
import BaseLayout from '../layouts/BaseLayout.astro';import PageVisualHero from '../components/PageVisualHero.astro';import { getPublicSiteDesign } from '../lib/site-settings';const design=await getPublicSiteDesign(),c=design.editorial.es,base=import.meta.env.BASE_URL;const photo=/^https?:/i.test(c.guidePhotoUrl)?c.guidePhotoUrl:base+c.guidePhotoUrl.replace(/^\//,'');
---
<BaseLayout title={c.guideKicker} description={c.guideIntro}><PageVisualHero kicker={c.guideKicker} title={c.guideTitle} intro={c.guideIntro} visual={design.pageVisuals.guide} locale="es" /><section class="section guide-panel"><figure class="guide-photo"><img src={photo} alt={c.guidePhotoAlt}/></figure><div><p class="kicker dark">{c.guideSectionKicker}</p><h2>{c.guideName}</h2><p class="large-copy">{c.guideBio}</p><p>{c.guideContactCopy}</p><a class="button outline" href={`${base}contacto/`}>{c.guideContactButton}</a></div></section><section class="section editorial-layout"><div><p class="kicker dark">{c.guideProjectKicker}</p><h2>{c.guideProjectTitle}</h2></div><div><p class="large-copy">{c.guideProjectLead}</p><p>{c.guideProjectBody}</p></div></section></BaseLayout>
