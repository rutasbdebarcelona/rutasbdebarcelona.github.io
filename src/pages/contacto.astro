---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---
<BaseLayout title="Contacto">
  <header class="page-hero compact"><div><p class="kicker">Conversemos</p><h1>Contacto</h1><p>Para consultas generales, grupos, hoteles, agencias y colaboraciones.</p></div></header>
  <section class="section contact-section">
    <div class="contact-card">
      <img src={`${import.meta.env.BASE_URL}images/marca/rutas-b-logo.png`} alt={siteConfig.formalName} />
      <div>
        <p class="kicker dark">Contacto directo</p>
        <h2>Cuéntanos qué necesitas</h2>
        <p>Escríbenos para resolver dudas sobre las rutas, organizar un grupo privado o conversar sobre colaboraciones con hoteles, agencias y partners.</p>
        <div class="contact-email" data-contact-email>{siteConfig.contact.email}</div>
        <p class="contact-location">{siteConfig.contact.location}</p>
        <div class="contact-actions">
          <button class="button outline" type="button" data-copy-email data-email={siteConfig.contact.email}>Copiar correo</button>
          <a class="button primary" target="_blank" rel="noreferrer" href={`https://mail.google.com/mail/?view=cm&fs=1&to=${siteConfig.contact.email}&su=Consulta%20desde%20la%20web%20de%20Rutas%20B`}>Escribir en Gmail</a>
        </div>
        <p class="copy-status" aria-live="polite" data-copy-status></p>
      </div>
    </div>
  </section>
  <script is:inline>
    document.querySelector('[data-copy-email]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      const status = document.querySelector('[data-copy-status]');
      try {
        await navigator.clipboard.writeText(button.dataset.email);
        if (status) status.textContent = 'Correo copiado.';
      } catch {
        const range = document.createRange();
        const email = document.querySelector('[data-contact-email]');
        if (email) {
          range.selectNodeContents(email);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
        if (status) status.textContent = 'Correo seleccionado: presiona Ctrl+C para copiar.';
      }
    });
  </script>
</BaseLayout>
