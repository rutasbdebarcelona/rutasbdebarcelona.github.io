---
import { moduleEnabled } from '../config/site';
import { ui, type Locale } from '../i18n/ui';
import type { SiteDesign } from '../lib/site-settings';
interface Props { locale?: Locale; design: SiteDesign; }
const { locale = 'es', design } = Astro.props;
const t = ui[locale];
const base = import.meta.env.BASE_URL;
const root = locale === 'en' ? base + 'en/' : base;
const current = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname.replace(/^\//, '');
const bare = current.startsWith('en/') ? current.slice(3) : current;
const esUrl = base + bare;
const enUrl = base + 'en/' + bare;
const fullLogo=design.logo==='full';
const showCopy=design.logo==='symbol-text';
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={root} aria-label={'Rutas B, ' + t.home}>
      <img class:list={['brand-logo',{'brand-logo-full':fullLogo}]} src={base + (fullLogo?'images/marca/rutas-b-logo.png':'images/marca/rutas-b-simbolo.png')} alt="" width={fullLogo?110:44} height={58} />
      {showCopy&&<span class="brand-copy"><strong>Rutas B</strong><small>de Barcelona</small></span>}
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-nav" data-menu-button><span>{t.menu}</span><span aria-hidden="true">&#9776;</span></button>
    <nav id="main-nav" class="main-nav" aria-label={t.navigation} data-menu>
      {moduleEnabled('routes') && <a href={root + 'rutas/'}>{t.routes}</a>}
      {moduleEnabled('compare') && <a href={root + 'comparar/'}>{t.compare}</a>}
      {moduleEnabled('guide') && <a href={root + 'sobre/'}>{t.guide}</a>}
      {moduleEnabled('faq') && <a href={root + 'preguntas/'}>{t.faq}</a>}
      {moduleEnabled('contact') && <a href={root + 'contacto/'}>{t.contact}</a>}
      <span class="language-switch" aria-label="Language"><a class:list={{active: locale === 'es'}} href={esUrl} lang="es">ES</a><span>/</span><a class:list={{active: locale === 'en'}} href={enUrl} lang="en">EN</a></span>
      {moduleEnabled('booking') && <a class="nav-cta" href={root + 'reservar/'}>{t.book}</a>}
    </nav>
  </div>
</header>