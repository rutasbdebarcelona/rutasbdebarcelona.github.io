---
import { siteConfig } from '../config/site';
import type { Locale } from '../i18n/ui';
import type { SiteDesign } from '../lib/site-settings';
import { getPublicPosts } from '../lib/publications';
interface Props { locale?: Locale; design: SiteDesign; }
const { locale = 'es',design } = Astro.props;
const copy=design.editorial[locale];
const base = import.meta.env.BASE_URL;
const root = locale === 'en' ? base + 'en/' : base;
const hasPublications=(await getPublicPosts()).length>0;
const logoSrc=/^https?:/i.test(design.branding.fullLogoUrl)?design.branding.fullLogoUrl:base+(design.branding.fullLogoUrl.startsWith('/')?design.branding.fullLogoUrl.slice(1):design.branding.fullLogoUrl);
---
<footer class="site-footer"><div class="footer-grid"><div><img class="footer-logo" src={logoSrc} alt={design.branding.fullLogoAlt||siteConfig.formalName} /><p>{copy.footerCopy}</p></div><div><h2>{copy.footerExplore}</h2>{design.pageVisibility.routes&&<a href={root + 'rutas/'}>{copy.footerRoutes}</a>}{design.pageVisibility.compare&&<a href={root + 'comparar/'}>{copy.footerCompare}</a>}{design.pageVisibility.booking&&<a href={root + 'reservar/'}>{copy.footerBook}</a>}{design.pageVisibility.reviews&&<a href={root + 'resenas/'}>{copy.footerReviews}</a>}{hasPublications&&design.pageVisibility.publications&&<a href={root + 'publicaciones/'}>{copy.footerPublications}</a>}</div><div><h2>{copy.footerInformation}</h2><span class="footer-contact">{siteConfig.contact.email}</span><span class="footer-contact">{siteConfig.contact.phoneDisplay}</span>{design.pageVisibility.contact&&<a href={root + 'contacto/'}>{copy.footerContact}</a>}<a href={root + 'privacidad/'}>{copy.footerPrivacy}</a><a href={root + 'condiciones/'}>{copy.footerTerms}</a><a href={base + 'admin/'}>{copy.footerAdmin}</a></div></div><div class="footer-bottom"><span>&copy; {new Date().getFullYear()} {siteConfig.shortName}</span><span>{siteConfig.contact.location}</span></div></footer>
