---
type Field={key:string;label:string;long?:boolean};
type Group={id:string;title:string;help:string;fields:Field[]};
const groups:Group[]=[
  {id:'chrome',title:'Marca, menú y pie',help:'Identidad y navegación compartidas por toda la web.',fields:[
    {key:'brandName',label:'Nombre junto al símbolo'},{key:'brandSubtitle',label:'Subtítulo de marca'},{key:'navRoutes',label:'Menú · Rutas / Tours'},{key:'navCompare',label:'Menú · Comparar'},{key:'navGuide',label:'Menú · Quién guía'},{key:'navFaq',label:'Menú · Preguntas'},{key:'navContact',label:'Menú · Contacto'},{key:'navBook',label:'Menú · Reservar'},
    {key:'footerCopy',label:'Pie · Presentación',long:true},{key:'footerExplore',label:'Pie · Título explorar'},{key:'footerRoutes',label:'Pie · Rutas'},{key:'footerCompare',label:'Pie · Comparar'},{key:'footerBook',label:'Pie · Reservar'},{key:'footerReviews',label:'Pie · Reseñas'},{key:'footerInformation',label:'Pie · Información'},{key:'footerContact',label:'Pie · Contacto'},{key:'footerPrivacy',label:'Pie · Privacidad'},{key:'footerTerms',label:'Pie · Condiciones'},{key:'footerAdmin',label:'Pie · Acceso privado'},{key:'footerPublications',label:'Pie · Publicaciones'}]},
  {id:'routes',title:'Catálogo de rutas',help:'Cabecera, filtros y textos de la página que reúne todas las rutas.',fields:[{key:'routesKicker',label:'Antetítulo'},{key:'routesTitle',label:'Título'},{key:'routesIntro',label:'Introducción',long:true},{key:'routesFilterAll',label:'Filtro · Todas'},{key:'routesFilterAvailable',label:'Filtro · Disponibles'},{key:'routesFilterPreparing',label:'Filtro · En preparación'}]},
  {id:'compare',title:'Comparar rutas',help:'Cabecera y nombres de las filas. Los datos de cada ruta se editan en Rutas.',fields:[{key:'compareKicker',label:'Antetítulo'},{key:'compareTitle',label:'Título'},{key:'compareIntro',label:'Introducción',long:true},{key:'compareFeature',label:'Característica'},{key:'compareArea',label:'Zona'},{key:'compareDuration',label:'Duración'},{key:'compareFormat',label:'Formato'},{key:'compareLanguages',label:'Idiomas'},{key:'compareIndividual',label:'Precio individual'},{key:'compareGroup',label:'Grupo privado'},{key:'compareAction',label:'Acción'},{key:'compareView',label:'Texto del enlace'}]},
  {id:'guide',title:'Quién guía',help:'Presentación del guía y del proyecto. La imagen también se reemplaza aquí.',fields:[{key:'guideKicker',label:'Antetítulo de página'},{key:'guideTitle',label:'Título de página',long:true},{key:'guideIntro',label:'Introducción',long:true},{key:'guideSectionKicker',label:'Antetítulo del guía'},{key:'guideName',label:'Nombre'},{key:'guideBio',label:'Biografía',long:true},{key:'guideContactCopy',label:'Invitación a contactar',long:true},{key:'guideContactButton',label:'Botón'},{key:'guidePhotoAlt',label:'Texto alternativo de la foto'},{key:'guideProjectKicker',label:'Antetítulo del proyecto'},{key:'guideProjectTitle',label:'Título del proyecto',long:true},{key:'guideProjectLead',label:'Texto principal',long:true},{key:'guideProjectBody',label:'Texto complementario',long:true}]},
  {id:'faq',title:'Preguntas frecuentes',help:'Edita la cabecera y la lista. Una línea por pregunta: Pregunta | Respuesta.',fields:[{key:'faqKicker',label:'Antetítulo'},{key:'faqTitle',label:'Título'},{key:'faqIntro',label:'Introducción',long:true}]},
  {id:'contact',title:'Contacto',help:'Textos de la página y del formulario. Los tipos de consulta se administran en Mensajes.',fields:[{key:'contactKicker',label:'Antetítulo'},{key:'contactPageTitle',label:'Título'},{key:'contactPageIntro',label:'Introducción',long:true},{key:'contactDirectKicker',label:'Antetítulo de contacto directo'},{key:'contactEmailLabel',label:'Etiqueta del correo'},{key:'contactPhoneLabel',label:'Etiqueta del teléfono'},{key:'contactNameLabel',label:'Campo · Nombre'},{key:'contactEmailFieldLabel',label:'Campo · Correo'},{key:'contactRequired',label:'Indicador obligatorio'},{key:'contactTypeLabel',label:'Campo · Tipo de consulta'},{key:'contactMessageLabel',label:'Campo · Mensaje'},{key:'contactPrivacyLead',label:'Privacidad · Inicio'},{key:'contactPrivacyLink',label:'Privacidad · Enlace'},{key:'contactPrivacyTail',label:'Privacidad · Cierre',long:true},{key:'contactSummaryTitle',label:'Resumen · Título'},{key:'contactSummaryCopy',label:'Resumen · Texto',long:true},{key:'contactSubmit',label:'Botón enviar'}]},
  {id:'booking',title:'Reserva',help:'Todos los textos visibles del formulario; la lógica y la disponibilidad permanecen protegidas.',fields:[{key:'bookingKicker',label:'Antetítulo'},{key:'bookingTitle',label:'Título'},{key:'bookingIntro',label:'Introducción',long:true},{key:'bookingStep1',label:'Paso 1'},{key:'bookingStep2',label:'Paso 2'},{key:'bookingStep3',label:'Paso 3'},{key:'bookingExperienceLegend',label:'Bloque experiencia'},{key:'bookingRouteLabel',label:'Campo ruta'},{key:'bookingRoutePlaceholder',label:'Opción inicial ruta'},{key:'bookingDateLabel',label:'Campo fecha'},{key:'bookingTimeLabel',label:'Campo horario'},{key:'bookingTimePlaceholder',label:'Opción inicial horario'},{key:'bookingTimeHelp',label:'Ayuda horario'},{key:'bookingLanguageLabel',label:'Campo idioma'},{key:'bookingPeopleLabel',label:'Campo personas'},{key:'bookingPartnerLabel',label:'Casilla partner',long:true},{key:'bookingContactLegend',label:'Bloque contacto'},{key:'bookingNameLabel',label:'Campo nombre'},{key:'bookingEmailLabel',label:'Campo correo'},{key:'bookingPhoneLabel',label:'Campo teléfono'},{key:'bookingOptional',label:'Indicador opcional'},{key:'bookingNotesLabel',label:'Campo solicitud especial'},{key:'bookingNotesPlaceholder',label:'Ayuda solicitud especial',long:true},{key:'bookingNotesLimit',label:'Límite de caracteres'},{key:'bookingPrivacyLead',label:'Privacidad · Inicio'},{key:'bookingPrivacyLink',label:'Privacidad · Enlace'},{key:'bookingPrivacyTail',label:'Privacidad · Cierre',long:true},{key:'bookingSummaryTitle',label:'Resumen · Título'},{key:'bookingSummaryCopy',label:'Resumen · Texto',long:true},{key:'bookingSubmit',label:'Botón reservar'}]},
  {id:'reviews',title:'Reseñas y confirmación',help:'Textos de confianza, formulario de reseñas y pantalla posterior a una reserva.',fields:[{key:'reviewsTrustTitle',label:'Reseñas · Título de confianza'},{key:'reviewsTrust1',label:'Reseñas · Garantía 1'},{key:'reviewsTrust2',label:'Reseñas · Garantía 2'},{key:'reviewsTrust3',label:'Reseñas · Garantía 3'},{key:'reviewsReferenceLabel',label:'Reseñas · Referencia'},{key:'reviewsEmailLabel',label:'Reseñas · Correo'},{key:'reviewsDisplayNameLabel',label:'Reseñas · Nombre público'},{key:'reviewsRatingLabel',label:'Reseñas · Valoración'},{key:'reviewsRatingPlaceholder',label:'Reseñas · Opción inicial'},{key:'reviewsBodyLabel',label:'Reseñas · Texto'},{key:'reviewsPrivacy',label:'Reseñas · Privacidad',long:true},{key:'reviewsSubmit',label:'Reseñas · Botón'},{key:'confirmationMode',label:'Confirmación · Antetítulo'},{key:'confirmationTitle',label:'Confirmación · Título'},{key:'confirmationCopy',label:'Confirmación · Introducción',long:true},{key:'confirmationReference',label:'Confirmación · Referencia'},{key:'confirmationRoute',label:'Confirmación · Ruta'},{key:'confirmationDate',label:'Confirmación · Fecha'},{key:'confirmationTime',label:'Confirmación · Horario'},{key:'confirmationMeeting',label:'Confirmación · Punto de encuentro',long:true},{key:'confirmationAddress',label:'Confirmación · Dirección'},{key:'confirmationTransport',label:'Confirmación · Transporte',long:true},{key:'confirmationReturn',label:'Confirmación · Botón volver'},{key:'confirmationEmailWarning',label:'Confirmación · Error de correo',long:true}]},  {id:'publications',title:'Publicaciones',help:'Textos de la portada pública del cuaderno. Cada artículo se crea en la pestaña Publicaciones.',fields:[{key:'publicationsKicker',label:'Antetítulo'},{key:'publicationsTitle',label:'Título'},{key:'publicationsIntro',label:'Introducción',long:true},{key:'publicationsEmpty',label:'Mensaje sin artículos'},{key:'publicationsReadMore',label:'Enlace leer más'},{key:'publicationsBack',label:'Enlace volver'}]},
  {id:'legal',title:'Privacidad y condiciones',help:'Contenido legal visible. Sigue siendo necesaria una revisión jurídica antes de operar comercialmente.',fields:[
    {key:'privacyKicker',label:'Privacidad · Antetítulo'},{key:'privacyTitle',label:'Privacidad · Título'},{key:'privacyWarning',label:'Privacidad · Aviso',long:true},{key:'privacy1Title',label:'Privacidad · Sección 1'},{key:'privacy1Body',label:'Privacidad · Texto 1',long:true},{key:'privacy2Title',label:'Privacidad · Sección 2'},{key:'privacy2Body',label:'Privacidad · Texto 2',long:true},{key:'privacy3Title',label:'Privacidad · Sección 3'},{key:'privacy3Body',label:'Privacidad · Texto 3',long:true},{key:'privacy4Title',label:'Privacidad · Sección 4'},{key:'privacy4Body',label:'Privacidad · Texto 4',long:true},
    {key:'termsKicker',label:'Condiciones · Antetítulo'},{key:'termsTitle',label:'Condiciones · Título'},{key:'termsWarning',label:'Condiciones · Aviso',long:true},{key:'terms1Title',label:'Condiciones · Sección 1'},{key:'terms1Body',label:'Condiciones · Texto 1',long:true},{key:'terms2Title',label:'Condiciones · Sección 2'},{key:'terms2Body',label:'Condiciones · Texto 2',long:true},{key:'terms3Title',label:'Condiciones · Sección 3'},{key:'terms3Body',label:'Condiciones · Texto 3',long:true},{key:'terms4Title',label:'Condiciones · Sección 4'},{key:'terms4Body',label:'Condiciones · Texto 4',long:true}]}
];
const visualGroups:Record<string,string[]>={routes:['routes','routesContent'],compare:['compare','compareContent'],guide:['guide','guideContent'],faq:['faq','faqContent'],contact:['contact','contactContent'],booking:['booking','bookingContent'],reviews:['reviews','reviewsContent'],publications:['publications','publicationsContent'],legal:['privacy','privacyContent','terms','termsContent']};
const visualLabels:Record<string,string>={routes:'Cabecera · Catálogo de rutas',routesContent:'Fondo opcional · Listado de rutas',compare:'Cabecera · Comparar',compareContent:'Fondo opcional · Tabla comparativa',guide:'Cabecera · Quién guía',guideContent:'Fondo opcional · Presentación del guía',faq:'Cabecera · Preguntas frecuentes',faqContent:'Fondo opcional · Preguntas y respuestas',contact:'Cabecera · Contacto',contactContent:'Fondo opcional · Formulario de contacto',booking:'Cabecera · Reserva',bookingContent:'Fondo opcional · Formulario de reserva',reviews:'Cabecera · Reseñas',reviewsContent:'Fondo opcional · Reseñas y formulario',publications:'Cabecera · Publicaciones',publicationsContent:'Fondo opcional · Listado de publicaciones',privacy:'Cabecera · Privacidad',privacyContent:'Fondo opcional · Contenido de privacidad',terms:'Cabecera · Condiciones',termsContent:'Fondo opcional · Contenido de condiciones'};
---
<div class="admin-panel pages-editor" data-pages-editor>
  <div class="admin-panel-head"><div><p class="kicker dark">Todas las páginas</p><h2>Contenido público sin puntos ciegos</h2></div><span data-pages-state></span></div>
  <p>Elige una página. Verás castellano e inglés juntos; las demás quedan cerradas para no convertir esto en un formulario infinito.</p>
  <form data-pages-form>
    <details class="home-editor-section" open><summary>Marca, logos y botones principales</summary>
      <div class="brand-editor-grid">
        <div><label class="field"><span>Logo horizontal o completo</span><input type="file" name="fullLogoFile" accept="image/png,image/webp,image/svg+xml,image/jpeg" /></label><input type="hidden" name="fullLogoUrl" /><img data-brand-preview="full" alt="Vista previa del logo completo" /></div>
        <div><label class="field"><span>Símbolo o logo vertical</span><input type="file" name="symbolLogoFile" accept="image/png,image/webp,image/svg+xml,image/jpeg" /></label><input type="hidden" name="symbolLogoUrl" /><img data-brand-preview="symbol" alt="Vista previa del símbolo" /></div>
      </div>
      <div class="design-options"><label class="field"><span>Alt logo completo</span><input name="fullLogoAlt" maxlength="160" /></label><label class="field"><span>Alt símbolo</span><input name="symbolLogoAlt" maxlength="160" /></label></div>
      <p class="field-help">El corrector conserva el original y ofrece fondo transparente, imagen completa o recorte. Nunca estira el logo.</p>
      <h3>Botones de portada</h3><div class="hero-action-editor">
        {(['book','routes','guide'] as const).map((action)=><label class="field"><span>{action==='book'?'Reservar':action==='routes'?'Explorar rutas':'Conocer al guía'}</span><select name={`${action}Order`}><option value="1">1º</option><option value="2">2º</option><option value="3">3º</option></select><input name={`${action}Link`} placeholder="reservar/ o https://..." /></label>)}
      </div>
    </details>
    <nav class="page-editor-tabs" aria-label="Páginas editables">{groups.map((group,index)=><button class:list={{active:index===0}} type="button" data-page-tab={group.id}>{group.title}</button>)}</nav>
    {groups.map((group,index)=><section class="page-editor-pane" data-page-pane={group.id} hidden={index!==0}><header><h3>{group.title}</h3><p>{group.help}</p></header>{group.id==='guide'&&<div class="guide-upload-editor"><label class="field"><span>Reemplazar foto del guía</span><input type="file" name="guidePhotoFile" accept="image/png,image/webp,image/jpeg" /></label><input type="hidden" name="guidePhotoUrl" /><img data-brand-preview="guide" alt="Vista previa de la foto del guía" /></div>}{visualGroups[group.id]?.map(key=><details class="page-visual-editor" data-page-visual={key}><summary>Recurso visual · {visualLabels[key]}</summary><div class="page-visual-grid"><div><label class="field"><span>Subir o reemplazar imagen</span><input type="file" name={`${key}VisualFile`} accept="image/png,image/webp,image/jpeg,image/avif" /></label><input type="hidden" name={`${key}VisualUrl`} /><img data-page-visual-preview={key} alt={`Vista previa de ${visualLabels[key]}`} /></div><div class="design-options"><label class="field"><span>Presentación</span><select name={`${key}VisualPresentation`}><option value="none">Sin imagen</option><option value="background">Foto de fondo editorial</option><option value="image">Imagen lateral</option></select></label><label class="field"><span>Ajuste</span><select name={`${key}VisualFit`}><option value="cover">Recortar para llenar</option><option value="contain">Mostrar completa</option></select></label><label class="range-field"><span>Foco horizontal</span><input name={`${key}VisualX`} type="range" min="0" max="100" /></label><label class="range-field"><span>Foco vertical</span><input name={`${key}VisualY`} type="range" min="0" max="100" /></label></div></div><div class="bilingual-editor"><div><h4>Castellano</h4><label class="field"><span>Descripción accesible</span><input name={`${key}VisualAltEs`} /></label><label class="field"><span>Texto del enlace opcional</span><input name={`${key}VisualLinkLabelEs`} placeholder="Vacío = sin botón" /></label></div><div><h4>English</h4><label class="field"><span>Accessible description</span><input name={`${key}VisualAltEn`} /></label><label class="field"><span>Optional link label</span><input name={`${key}VisualLinkLabelEn`} placeholder="Empty = no button" /></label></div></div><label class="field"><span>Destino del enlace opcional</span><input name={`${key}VisualLinkUrl`} placeholder="contacto/ o https://..." /></label><p class="field-help">{key.endsWith('Content')?'Este recurso es independiente de la cabecera y se aplica solo a esta zona de contenido. El contenido conserva una superficie legible y el diseño se adapta a móvil; «Sin imagen» guarda el archivo sin mostrarlo.':'Esta es la cabecera propia de esta página: no modifica el logo, la navegación ni las cabeceras de otras páginas. Usa «Mostrar completa» para evitar recortes; repetir una imagen en otra página siempre será una decisión manual.'}</p></details>)}<div class="bilingual-editor"><div><h3>Castellano</h3>{group.fields.map(field=><label class="field"><span>{field.label}</span>{field.long?<textarea rows="3" data-copy-locale="es" data-copy-key={field.key}></textarea>:<input data-copy-locale="es" data-copy-key={field.key} />}</label>)}</div><div><h3>English</h3>{group.fields.map(field=><label class="field"><span>{field.label}</span>{field.long?<textarea rows="3" data-copy-locale="en" data-copy-key={field.key}></textarea>:<input data-copy-locale="en" data-copy-key={field.key} />}</label>)}</div></div>{group.id==='faq'&&<div class="bilingual-editor faq-editor"><label class="field"><span>Preguntas ES · una por línea: pregunta | respuesta</span><textarea rows="10" data-faq-locale="es"></textarea></label><label class="field"><span>Questions EN · one per line: question | answer</span><textarea rows="10" data-faq-locale="en"></textarea></label></div>}</section>)}
    <p class="admin-error" data-pages-message role="status"></p><div class="route-editor-actions"><button class="button outline" type="submit">Guardar borrador</button><button class="button primary" type="button" data-pages-publish>Publicar en web</button></div>
  </form>
</div>
<script src="../scripts/editorial-pages-editor.ts"></script>
<style>
  .pages-editor{display:grid;gap:18px}.page-editor-tabs{display:flex;gap:6px;overflow:auto;padding:7px;background:var(--paper);border:1px solid var(--line)}.page-editor-tabs button{border:0;background:transparent;padding:10px 14px;white-space:nowrap;font:inherit;font-weight:700;cursor:pointer}.page-editor-tabs button.active{background:var(--forest);color:#fff}.page-editor-pane>header{margin:22px 0}.page-editor-pane>header h3{font-size:1.55rem;margin:0}.page-editor-pane>header p{color:var(--muted)}.brand-editor-grid,.hero-action-editor{display:grid;grid-template-columns:1fr 1fr;gap:16px}.brand-editor-grid img,.guide-upload-editor img{display:block;width:100%;height:150px;object-fit:contain;background:linear-gradient(45deg,#eee 25%,transparent 25%),linear-gradient(-45deg,#eee 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eee 75%),linear-gradient(-45deg,transparent 75%,#eee 75%);background-size:20px 20px;background-position:0 0,0 10px,10px -10px,-10px 0;border:1px solid var(--line)}.guide-upload-editor{max-width:520px;margin-bottom:18px}.hero-action-editor{grid-template-columns:repeat(3,1fr)}.hero-action-editor .field{display:grid;grid-template-columns:90px 1fr;gap:6px}.hero-action-editor .field span{grid-column:1/-1}.faq-editor{margin-top:18px}.page-visual-editor{margin:18px 0;border:1px solid var(--line);padding:0 18px 18px;overflow:hidden}.page-visual-editor>summary{padding:16px 0;font-weight:800;cursor:pointer}.page-visual-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:18px}.page-visual-grid>div{min-width:0}.page-visual-grid>.design-options{grid-template-columns:repeat(2,minmax(0,1fr));max-width:900px}.page-visual-grid .range-field{min-width:0}.page-visual-grid .range-field input{display:block;width:100%;min-width:0}.page-visual-grid img{display:block;width:min(100%,720px);height:220px;object-fit:contain;background:var(--paper);border:1px solid var(--line)}@media(max-width:850px){.brand-editor-grid,.hero-action-editor,.page-visual-grid>.design-options{grid-template-columns:1fr}.page-editor-tabs{margin-inline:-16px}}
</style>
