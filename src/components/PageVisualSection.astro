---
import type { PageVisualSettings } from '../lib/site-settings';
interface Props { visual:PageVisualSettings; class?:string; locale?:'es'|'en'; }
const {visual,class:className='',locale='es',...sectionProps}=Astro.props;
const base=import.meta.env.BASE_URL;
const hasImage=Boolean(visual?.url)&&visual.presentation!=='none';
const src=hasImage?(/^https?:/i.test(visual.url)?visual.url:base+visual.url.replace(/^\//,'')):'';
const alt=locale==='en'?visual.altEn:visual.altEs;
const linkLabel=locale==='en'?visual.linkLabelEn:visual.linkLabelEs;
const internalLink=visual.linkUrl?.replace(/^\//,'')||'';
const localizedLink=locale==='en'&&internalLink&&!internalLink.startsWith('en/')?'en/'+internalLink:internalLink;
const href=visual.linkUrl?(/^https?:/i.test(visual.linkUrl)?visual.linkUrl:base+localizedLink):'';
const isPanel=hasImage&&visual.presentation==='image';
const isBackground=hasImage&&visual.presentation==='background';
const style=hasImage?`--section-visual:url("${src}");--section-x:${visual.x}%;--section-y:${visual.y}%;--section-fit:${visual.fit};`:'';
---
<section {...sectionProps} class:list={['section','page-visual-section',className,{'has-section-visual':hasImage,'section-image-background':isBackground,'section-image-panel':isPanel}]} style={style}>
  <div class="page-visual-section-inner"><slot />{href&&linkLabel&&<a class="button outline page-visual-section-link" href={href}>{linkLabel}</a>}</div>
  {isPanel&&<figure class="page-visual-section-media"><img src={src} alt={alt||''}/></figure>}
</section>
<style>
  .page-visual-section{position:relative;isolation:isolate;overflow:hidden}
  .section-image-background{padding-inline:clamp(18px,3vw,44px)}
  .section-image-background:before{content:"";position:absolute;inset:0;z-index:-2;background:var(--paper) var(--section-visual) no-repeat;background-size:var(--section-fit);background-position:var(--section-x) var(--section-y);filter:saturate(.72) contrast(1.02)}
  .section-image-background:after{content:"";position:absolute;inset:0;z-index:-1;background:rgba(244,239,230,.78)}
  .page-visual-section-inner{position:relative;z-index:1;min-width:0}
  .section-image-background .page-visual-section-inner{padding:clamp(18px,3vw,38px);background:rgba(251,248,242,.9);box-shadow:0 18px 50px rgba(13,41,34,.1)}
  .section-image-panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.62fr);gap:clamp(24px,4vw,54px);align-items:stretch}
  .page-visual-section-media{margin:0;min-height:320px;overflow:hidden;background:var(--paper)}
  .page-visual-section-media img{width:100%;height:100%;min-height:320px;object-fit:var(--section-fit);object-position:var(--section-x) var(--section-y)}
  .page-visual-section-link{margin-top:24px}
  @media(max-width:760px){.section-image-panel{grid-template-columns:1fr}.page-visual-section-media,.page-visual-section-media img{min-height:230px}}
  @media(max-width:620px){.section-image-background{padding-inline:10px}.section-image-background .page-visual-section-inner{padding:10px}}
</style>