---
interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
const message = locale === 'en'
  ? 'Hello, I have a question about Rutas B de Barcelona tours.'
  : 'Hola, tengo una consulta sobre las rutas de Rutas B de Barcelona.';
const href = `https://wa.me/34637705174?text=${encodeURIComponent(message)}`;
const label = locale === 'en' ? 'Ask us on WhatsApp' : 'Escríbenos por WhatsApp';
---

<a class="whatsapp-float" href={href} target="_blank" rel="noopener noreferrer" aria-label={label} title={label}>
  <svg viewBox="0 0 24 24" aria-hidden="true">
