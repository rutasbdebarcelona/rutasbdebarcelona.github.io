---
import type { PageVisualSettings } from '../lib/site-settings';
interface Props { kicker:string; title:string; intro?:string; visual:PageVisualSettings; locale?:'es'|'en'; compact?:boolean; variant?:'default'|'faq'|'about'; }
const {kicker,title,intro='',visual,locale='es',compact=false,variant='default'}=Astro.props;
const base=import.meta.env.BASE_URL;
const hasImage=Boolean(visual?.url)&&visual.presentation!=='none';
const src=hasImage?(/^https?:/i.test(visual.url)?visual.url:base+visual.url.replace(/^\//,'')):'';
const alt=locale==='en'?visual.altEn:visual.altEs;
const linkLabel=locale==='en'?visual.linkLabelEn:visual.linkLabelEs;
const internalLink=visual.linkUrl?.replace(/^\//,'')||'';
const localizedLink=locale==='en'&&internalLink&&!internalLink.startsWith('en/')?'en/'+internalLink:internalLink;
const href=visual.linkUrl?(/^https?:/i.test(visual.linkUrl)?visual.linkUrl:base+localizedLink):'';
const style=hasImage?`--page-visual:url("${src}");--page-x:${visual.x}%;--page-y:${visual.y}%;--page-fit:${visual.fit};`:'';
---
<header class:list={['page-hero','editable-page-hero',`page-hero-${variant}`,{compact, 'has-page-image':hasImage,'page-image-panel':hasImage&&visual.presentation==='image','page-image-background':hasImage&&visual.presentation==='background'}]} style={style}>
  <div class="page-hero-copy"><p class="kicker">{kicker}</p><h1>{title.split('\n').map((line,index)=><>{index>0&&<br/>}{line}</>)}</h1>{intro&&<p>{intro}</p>}{href&&linkLabel&&<a class="button outline page-hero-link" href={href}>{linkLabel}</a>}</div>
  {hasImage&&visual.presentation==='image'&&<figure class="page-hero-media"><img src={src} alt={alt||''}/></figure>}
</header>
<style>
  .editable-page-hero{position:relative;overflow:hidden}.page-hero-copy{position:relative;z-index:1}.page-hero-about{height:420px;min-height:420px;align-items:stretch}.page-hero-about>.page-hero-copy{margin-block:0;padding-block:48px}.page-hero-about .page-hero-copy h1{font-size:clamp(3rem,5vw,4.25rem);line-height:.98}.page-hero-link{margin-top:18px}.page-image-panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.72fr);align-items:stretch}.page-hero-media{margin:0;min-height:300px;overflow:hidden}.page-hero-media img{width:100%;height:100%;min-height:300px;object-fit:var(--page-fit);object-position:var(--page-x) var(--page-y)}
  .page-image-background{color:#fff;background:var(--forest);isolation:isolate}.page-image-background:before{content:"";position:absolute;inset:0;z-index:-2;background-image:var(--page-visual);background-size:var(--page-fit);background-repeat:no-repeat;background-position:var(--page-x) var(--page-y);filter:saturate(.72) contrast(1.04)}.page-image-background:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(7,31,25,.93),rgba(7,31,25,.7) 54%,rgba(7,31,25,.42))}.page-image-background .page-hero-copy{width:min(1180px,calc(100% - 40px));max-width:none;margin-inline:auto}.page-image-background .page-hero-copy h1{max-width:820px}.page-image-background .page-hero-link{color:#fff;border-color:rgba(255,255,255,.7)}.page-hero-faq.page-image-background:before{background-position:100% var(--page-y)}.page-hero-faq.page-image-background:after{background:linear-gradient(90deg,rgba(7,31,25,.95) 0%,rgba(7,31,25,.88) 54%,rgba(7,31,25,.38) 78%,rgba(7,31,25,.2) 100%)}.page-hero-faq .page-hero-copy h1{max-width:760px}
  @media(max-width:760px){.page-image-background .page-hero-copy{width:calc(100% - 28px)}.page-hero-about{height:auto;min-height:390px}.page-hero-about>.page-hero-copy{padding-block:48px}.page-hero-about .page-hero-copy h1{font-size:clamp(2.8rem,12vw,4rem)}.page-image-panel{display:grid;grid-template-columns:1fr}.page-hero-media,.page-hero-media img{min-height:230px}.page-image-background:after{background:linear-gradient(rgba(7,31,25,.87),rgba(7,31,25,.72))}}
</style>
