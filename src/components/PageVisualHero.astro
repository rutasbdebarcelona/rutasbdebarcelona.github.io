---
import type { PageVisualSettings } from '../lib/site-settings';
interface Props { kicker:string; title:string; intro?:string; visual:PageVisualSettings; locale?:'es'|'en'; compact?:boolean; }
const {kicker,title,intro='',visual,locale='es',compact=false}=Astro.props;
const base=import.meta.env.BASE_URL;
const hasImage=Boolean(visual?.url)&&visual.presentation!=='none';
const src=hasImage?(/^https?:/i.test(visual.url)?visual.url:base+visual.url.replace(/^\//,'')):'';
const alt=locale==='en'?visual.altEn:visual.altEs;
const linkLabel=locale==='en'?visual.linkLabelEn:visual.linkLabelEs;
const internalLink=visual.linkUrl?.replace(/^\//,'')||'';
const localizedLink=locale==='en'&&internalLink&&!internalLink.startsWith('en/')?'en/'+internalLink:internalLink;
const href=visual.linkUrl?(/^https?:/i.test(visual.linkUrl)?visual.linkUrl:base+localizedLink):'';
const style=hasImage?`--page-visual:url("${src}");--page-x:${visual.x}%;--page-y:${visual.y}%;--page-fit:${visual.fit};`:'';
---
<header class:list={['page-hero','editable-page-hero',{compact, 'has-page-image':hasImage,'page-image-panel':hasImage&&visual.presentation==='image','page-image-background':hasImage&&visual.presentation==='background'}]} style={style}>
  <div class="page-hero-copy"><p class="kicker">{kicker}</p><h1>{title.split('\n').map((line,index)=><>{index>0&&<br/>}{line}</>)}</h1>{intro&&<p>{intro}</p>}{href&&linkLabel&&<a class="button outline page-hero-link" href={href}>{linkLabel}</a>}</div>
  {hasImage&&visual.presentation==='image'&&<figure class="page-hero-media"><img src={src} alt={alt||''}/></figure>}
</header>
<style>
  .editable-page-hero{position:relative;overflow:hidden}.page-hero-copy{position:relative;z-index:1}.page-hero-link{margin-top:18px}.page-image-panel{grid-template-columns:minmax(0,1fr) minmax(280px,.72fr);align-items:stretch}.page-hero-media{margin:0;min-height:300px;overflow:hidden}.page-hero-media img{width:100%;height:100%;min-height:300px;object-fit:var(--page-fit);object-position:var(--page-x) var(--page-y)}
  .page-image-background{color:#fff;background-image:linear-gradient(90deg,rgba(10,35,29,.9),rgba(10,35,29,.54)),var(--page-visual);background-size:var(--page-fit);background-repeat:no-repeat;background-position:var(--page-x) var(--page-y)}.page-image-background .page-hero-copy{max-width:820px}.page-image-background .page-hero-link{color:#fff;border-color:rgba(255,255,255,.7)}
  @media(max-width:760px){.page-image-panel{grid-template-columns:1fr}.page-hero-media,.page-hero-media img{min-height:230px}.page-image-background{background-image:linear-gradient(rgba(10,35,29,.82),rgba(10,35,29,.72)),var(--page-visual)}}
</style>
