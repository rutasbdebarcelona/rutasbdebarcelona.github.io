---
import type { TourRoute } from '../data/routes';
import type { Locale } from '../i18n/ui';
interface Props { route: TourRoute; locale?: Locale; }
const { route, locale = 'es' } = Astro.props;
const base = import.meta.env.BASE_URL;
const root = locale === 'en' ? base + 'en/' : base;
const image = /^https?:/i.test(route.image) ? route.image : base + route.image.replace(/^\//, '');
const labels = locale === 'en' ? { view: 'View tour', duration: 'Duration', area: 'Area' } : { view: 'Ver la ruta', duration: 'Duración', area: 'Zona' };
---
<article class="route-card">
  <a class="route-card-image" href={root + 'rutas/' + route.slug + '/'} aria-label={labels.view + ': ' + route.title}><img src={image} alt={route.imageAlt} loading="lazy" />{route.status !== 'available' && <span class:list={['status-pill', route.status]}>{route.statusLabel}</span>}</a>
  <div class="route-card-body"><p class="eyebrow">{route.eyebrow}</p><h2><a href={root + 'rutas/' + route.slug + '/'}>{route.title}</a></h2><p>{route.promise}</p><dl class="route-facts"><div><dt>{labels.duration}</dt><dd>{route.duration}</dd></div><div><dt>{labels.area}</dt><dd>{route.area}</dd></div></dl><div class="card-actions"><a class="text-link" href={root + 'rutas/' + route.slug + '/'}>{labels.view} <span aria-hidden="true">&rarr;</span></a></div></div>
</article>
